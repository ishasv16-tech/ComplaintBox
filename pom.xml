<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <!-- Project -->
  <groupId>com.complaintbox</groupId>
  <artifactId>complaintbox</artifactId>
  <version>1.0.0</version>

  <name>ComplaintBox</name>
  <description>Hostel Maintenance Complaint Tracker</description>

  <!-- Java -->
  <properties>
    <java.version>21</java.version>
    <lombok.version>1.18.42</lombok.version>
  </properties>


  <!-- ========================= -->
  <!-- DEPENDENCIES              -->
  <!-- ========================= -->

  <dependencies>

    <!-- Spring Web / REST API -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Data JPA -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Password encryption -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- MySQL -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>


  <!-- ========================= -->
  <!-- BUILD                     -->
  <!-- ========================= -->

  <build>

    <plugins>

      <!-- ========================= -->
      <!-- Maven Compiler            -->
      <!-- ========================= -->

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>

        <configuration>

          <source>21</source>
          <target>21</target>

          <annotationProcessorPaths>

            <!-- Lombok Annotation Processor -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>

          </annotationProcessorPaths>

        </configuration>
      </plugin>


      <!-- ========================= -->
      <!-- Spring Boot                -->
      <!-- ========================= -->

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>


      <!-- ========================= -->
      <!-- React / Vite Frontend      -->
      <!-- ========================= -->

      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.0</version>

        <configuration>

          <!-- React project root -->
          <workingDirectory>
            ${project.basedir}
          </workingDirectory>

          <!-- Node installed inside target -->
          <installDirectory>
            ${project.build.directory}
          </installDirectory>

          <!-- Versions -->
          <nodeVersion>v22.16.0</nodeVersion>
          <pnpmVersion>10.4.1</pnpmVersion>

        </configuration>

        <executions>

          <!-- ========================= -->
          <!-- Install Node + PNPM         -->
          <!-- ========================= -->

          <execution>
            <id>install-node-and-pnpm</id>

            <phase>generate-resources</phase>

            <goals>
              <goal>install-node-and-pnpm</goal>
            </goals>
          </execution>


          <!-- ========================= -->
          <!-- PNPM INSTALL                -->
          <!-- ========================= -->

          <execution>
            <id>pnpm-install</id>

            <phase>generate-resources</phase>

            <goals>
              <goal>pnpm</goal>
            </goals>

            <configuration>
              <arguments>
                install
              </arguments>
            </configuration>
          </execution>


          <!-- ========================= -->
          <!-- BUILD REACT FRONTEND        -->
          <!-- ========================= -->

          <execution>
            <id>pnpm-build</id>

            <phase>generate-resources</phase>

            <goals>
              <goal>pnpm</goal>
            </goals>

            <configuration>
              <arguments>
                run build
              </arguments>
            </configuration>
          </execution>

        </executions>

      </plugin>

    </plugins>

  </build>

</project>